{
    "name": "nhanaz-plugins/scorehud",
    "description": "ScoreHud maintained for current Axolotl-PM releases",
    "type": "library",
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "^5.45.0",
        "phpstan/phpstan": "^2.2.7"
    },
    "autoload": {
        "classmap": ["src"]
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --level=max --no-progress"
    }
}
